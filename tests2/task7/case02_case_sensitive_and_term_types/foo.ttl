@base <http://example.org/> .
@prefix ont: <http://ont.example.org/> .
@prefix ex: <http://example.org/> .

<jane> ex:p "fred" .
<jane> ex:p <Fred> .
<Jane> ont:hasName "Fred" .
<jane> ont:hasName <Fred> .
<jane> ex:p "Sally" .
<john> <http://example.org/ont/hasName> "Fred" .
<john> ont:hasName "Sally" .
<john> ex:p "Sally" .
<mary> ont:hasName <Sally> .
<mary> ex:p "Frederick" .
