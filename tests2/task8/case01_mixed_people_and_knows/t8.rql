let foo = load "foo"

let people = match {
  in foo { ?x <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://xmlns.com/foaf/0.1/Person> }
}

let knowsNmg = match {
  in foo { ?x <http://xmlns.com/foaf/0.1/knows> <http://example.org/nmg> }
}

let missing = difference people knowsNmg

let g = construct {
  ?x <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://xmlns.com/foaf/0.1/Person>
} from missing

print g
