@base <http://example.org/> .
@prefix dc10: <http://purl.org/dc/elements/1.0/> .
@prefix dc11: <http://purl.org/dc/elements/1.1/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.org/> .

<book1> dc10:creator <alice> .
<book2> dc11:creator <bob> .
<book3> dc10:creator <carol> .
<book3> dc11:creator <dave> .
<book4> dct:creator <ellen> .
<book5> ex:creator <frank> .
<book6> ex:title "Some Book" .
<http://example.org/book1> <http://purl.org/dc/elements/1.0/creator> <http://example.org/alice> .